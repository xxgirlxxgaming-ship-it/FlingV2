local Status_LastLabel     = FlingTab:CreateLabel("Last Fling: Never")
local Status_SettingsLabel = FlingTab:CreateLabel("Settings → Strength: 2.0 | Duration: 2.5s")

local function FormatTimeSince(t)
    if t == 0 then return "Never" end
    local diff = os.time() - t
    if diff < 1 then return "Just now" end
    if diff < 60 then return diff .. "s ago" end
    local mins = math.floor(diff / 60)
    if mins < 60 then return mins .. "m ago" end
    local hrs = math.floor(mins / 60)
    return hrs .. "h ago"
end

local function UpdateFlingStatus()
    local count = CountSelectedTargets()
    local state = FlingActive and "RUNNING" or "IDLE"

    Status_StateLabel:Set("State: " .. state .. (FlingActive and "  |  Mode: Multi-Target" or ""))
    Status_TargetsLabel:Set("Targets Selected: " .. tostring(count))
    Status_CyclesLabel:Set("Fling Cycles: " .. tostring(TotalFlingCycles))
    Status_LastLabel:Set("Last Fling: " .. FormatTimeSince(LastFlingTime))
    Status_SettingsLabel:Set(string.format("Settings → Strength: %.1f | Duration: %.1fs", FlingStrength, FlingDuration))
end


