TouchFlingTab:CreateSection("Touch Fling Controls")

local TouchFlingEnabled = false
local TouchFlingConnection

local TouchFlingStrength = 1.0 -- default multiplier

local function parseTouchStrength(Text)
    Text = tostring(Text or ""):lower():gsub("%s+", "")
    if Text == "inf" or Text == "infinity" or Text == "+inf" or Text == "-inf" then
        return math.huge
    end
    local n = tonumber(Text)
    if not n or n <= 0 then
        return nil
    end
    return n
end

TouchFlingTab:CreateInput({
    Name                     = "Touch Fling Strength",
    PlaceholderText          = "Type a strength (e.g. 1, 2.5, 5, inf)",
    RemoveTextAfterFocusLost = false,
    Callback                 = function(Text)
        local num = parseTouchStrength(Text)
        if not num then
            Message("Touch Fling", "Invalid strength value. Please type a positive number or 'inf'.", 3)
            return
        end

        TouchFlingStrength = num
        if num == math.huge then
            Message("Touch Fling", "Strength set to infinity.", 3)
        else
            Message("Touch Fling", "Strength set to " .. tostring(num), 2)
        end
    end,
})

-- Touch Fling core logic (UNCHANGED)
local function TouchFlingLoop()
    local Player1 = Players.LocalPlayer
    local character, hrp, baseV

    while TouchFlingEnabled do
        RunService.Heartbeat:Wait()
        character = Player1.Character
        hrp = character and character:FindFirstChild("HumanoidRootPart")

        if hrp then
            baseV = hrp.Velocity

            -- When strength is extremely large, math.huge can appear – clamp just at the
            -- math operation level so the script doesn't error, but we DO NOT clamp
            -- TouchFlingStrength itself.
            local s = TouchFlingStrength
            if s == math.huge then
                s = 1e6 -- treat infinity as a huge number for the actual physics step
            end

            local horiz = Vector3.new(baseV.X, 0, baseV.Z)
            if horiz.Magnitude > 0 then
                horiz = horiz.Unit * (horiz.Magnitude * s)
            end

            local verticalBoost = 5000 * s

            -- Prevent NaN/inf from breaking physics: if values go crazy, just skip that frame
            if horiz.X == horiz.X and horiz.Y == horiz.Y and horiz.Z == horiz.Z and
               verticalBoost == verticalBoost then
                hrp.Velocity = horiz + Vector3.new(0, verticalBoost, 0)

                RunService.RenderStepped:Wait()
                hrp.Velocity = baseV

                RunService.Stepped:Wait()
            else
                -- bad math (NaN/inf), just restore and wait
                hrp.Velocity = baseV
                RunService.Stepped:Wait()
            end
        end
    end
end

local function EnableTouchFling()
    if TouchFlingEnabled then return end
    TouchFlingEnabled = true

    TouchFlingConnection = task.spawn(function()
        TouchFlingLoop()
    end)

    Message("Touch Fling", "Touch Fling enabled.", 3)
end

local function DisableTouchFling()
    if not TouchFlingEnabled then return end
    TouchFlingEnabled = false
    TouchFlingConnection = nil
    Message("Touch Fling", "Touch Fling disabled.", 3)
end

