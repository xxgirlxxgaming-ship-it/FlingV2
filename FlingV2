-- //  START / STOP FLING
-- ////////////////////////////////////////////////////////////////

local function StartFling()
    if FlingActive then return end

    local count = CountSelectedTargets()
    if count == 0 then
        Message("Destiny Fling", "No targets selected!", 2)
        UpdateFlingStatus()
        return
    end

    FlingActive = true
    TotalFlingCycles = 0
    UpdateFlingStatus()
    Message("Started", "Winter's Multi-Person Fling: flinging " .. count .. " target(s)", 2)

    task.spawn(function()
        while FlingActive do
            local validTargets = {}

            for name, plr in pairs(SelectedTargets) do
                if plr and plr.Parent then
                    validTargets[name] = plr
                else
                    SelectedTargets[name] = nil
                end
            end

            if next(validTargets) ~= nil then
                TotalFlingCycles += 1
                LastFlingTime = os.time()
            end

            for _, plr in pairs(validTargets) do
                if not FlingActive then break end
                SkidFling(plr)
                task.wait(0.1)
            end

            UpdateFlingStatus()
            task.wait(0.5)
        end
    end)
end

local function StopFling()
    if not FlingActive then return end

    FlingActive = false
    UpdateFlingStatus()
    Message("Stopped", "Winter's Multi-Person Fling has been stopped", 2)
end

