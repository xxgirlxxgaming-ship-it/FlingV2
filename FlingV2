-- Stored as Enum.KeyCode. Defaults (can be changed via UI below):
local TouchFlingKey = Enum.KeyCode.T       -- default key to toggle Touch Fling
local TpToolKey     = Enum.KeyCode.Y       -- default key to execute Teleport Tool

-- Return a valid KeyCode from a string, or nil if invalid/forbidden.
local function StringToKeyCode(str)
    if not str or str == "" then return nil end
    str = string.upper(str)

    -- Disallow K completely (used by Rayfield UI toggle)
    if str == "K" then
        return nil
    end

    -- Try direct mapping for single letters and digits
    if #str == 1 then
        -- Letters
        if str:match("%a") then
            local ok, kc = pcall(function()
                return Enum.KeyCode[str]
            end)
            if ok and kc ~= nil then
                return kc
            end
        end
        -- Digits 0-9
        if str:match("%d") then
            local ok, kc = pcall(function()
                return Enum.KeyCode["D" .. str]
            end)
            if ok and kc ~= nil then
                return kc
            end
        end
    end

    -- Try full Enum name, e.g. "LEFTSHIFT", "SPACE", etc.
    local ok, kc = pcall(function()
        return Enum.KeyCode[str]
    end)
    if ok and kc ~= nil and kc ~= Enum.KeyCode.K then
        return kc
    end

    return nil
end

local function KeyCodeToString(kc)
    if not kc then return "None" end
    return kc.Name or tostring(kc)
end

