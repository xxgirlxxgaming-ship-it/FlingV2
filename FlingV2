            local flag = Rayfield.Flags["DestinyTouchFlingToggle"]
            if flag and flag.Set then
                flag:Set(false)
            end
        else
            EnableTouchFling()
            local flag = Rayfield.Flags["DestinyTouchFlingToggle"]
            if flag and flag.Set then
                flag:Set(true)
            end
        end

    -- Teleport Tool keybind
    elseif key == TpToolKey then
        pcall(function()
